# Copie este arquivo para ".env" e preencha com seus dados reais.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- Discord ---
DISCORD_WEBHOOK_URL=sua_webhook_url_aqui

# --- Canal de notificacao: telegram | discord | both ---
NOTIFICATION_CHANNEL=both

# --- Caminho do CSV com o historico dos times (hit rate Over 0.5 HT etc.) ---
TEAM_STATS_CSV=data/team_stats.csv

# --- Caminho do banco de deduplicacao (SQLite) ---
DEDUP_DB=data/alerts.db
